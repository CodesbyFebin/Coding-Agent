# --- Required: NVIDIA Nemotron via Nebius Token Factory ---
NEBIUS_API_KEY=
# Optional overrides
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Optional: Tavily web research for the Researcher agent ---
TAVILY_API_KEY=

# --- Sandbox for write -> run -> test ---
# vercel (auto on Vercel, uses @vercel/sandbox + OIDC) | docker | local (dev only)
# SANDBOX_RUNNER=local
# SANDBOX_DOCKER_IMAGE=node:22-slim
# SANDBOX_TIMEOUT_MS=60000
# REPAIR_MAX_ATTEMPTS=3

# --- Optional legacy provider ---
# XAI_API_KEY=

# --- Ship pipeline ---
# PREVIEW_TTL_MS=900000
# DEPLOY_HOOK_URL=            # only called after a human types DEPLOY; unset = dry run

# --- RedAgent ---
# REDAGENT_MODE=off           # on: tool wrappers intercept; off: fully transparent
# REDAGENT_MOCKER_TIER=super  # or ultra
# REDAGENT_DB_DIR=./.redagent-db
# REDAGENT_GITHUB_REPO=owner/name   # enables the user-triggered "File GitHub issue" button (needs gh auth)

# --- MERIDIAN GreenOps (estimate assumptions; defaults shown) ---
# GREENOPS_FLOPS_PER_JOULE=4e11
# GREENOPS_PUE=1.2
# GREENOPS_GRID_G_PER_KWH=475
# GREENOPS_SANDBOX_WATTS=15

# --- CI Whisperer + PCM (Project DNA) ---
# PCM_DNA=off                 # disable DNA grounding of Nemotron calls
# PCM_DNA_DIR=./.pcm-dna      # where DNA JSON is persisted
# PCM_DNA_TOKEN=              # Bearer token for GET /api/dna (required in production)
# WHISPERER_STRICT=1          # `npm run whisperer -- audit` exits 1 on blocking findings
# GitHub Action: add NEBIUS_API_KEY as a repository secret for the Nemotron part.

# --- Optional providers (Nemotron on Nebius stays the default; these are used only when selected) ---
# META_LLAMA_API_KEY=          # server-side only
# META_BASE_URL=https://api.meta.ai/v1   # unverified default; override if needed
# META_SPEND_CAP_USD=1         # hard cap (default 1 when unset); calls are refused past it
# META_SPEND_LOG=./.meta-spend.jsonl
# LOCAL_LLAMA_BASE_URL=http://127.0.0.1:8089/v1   # llama.cpp server
# LLAMA_GUARD=off              # set to on to check prompts with Llama Guard 3
# LLAMA_GUARD_URL=http://127.0.0.1:8090/v1
