# Copy to .env and fill in real values. Never commit a real .env.

PORT=3000
NODE_ENV=development

# Postgres/Neon connection string.
DATABASE_URL=postgres://user:pass@host:5432/db

# Secret used to sign JWTs issued by /api/v1/auth. Use a long random value.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Base URL of a local Ollama server used by the Ollama model-gateway adapter.
OLLAMA_BASE_URL=http://localhost:11434

# Shared secret checked by api/cron/scheduler-tick.js against the
# Authorization: Bearer <CRON_SECRET> header Vercel Cron sends. Required for
# the Vercel deployment; unused when running the server locally.
CRON_SECRET=replace-with-a-long-random-secret
