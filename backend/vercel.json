{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/cron/scheduler-tick.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/api/((?!cron/).*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scheduler-tick",
      "schedule": "*/5 * * * *"
    }
  ]
}
