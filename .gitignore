# Dependencies (frontend + any future backend)
node_modules/
.pnp
.pnp.js

# Build output
frontend/dist/
frontend/dist-ssr/
web/.next/
web/out/
*.local

# Testing artifacts
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/.nyc_output/

# Storybook
frontend/storybook-static/

# TypeScript build info
frontend/.tsbuildinfo*
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel/

# Cache
.cache/
.cache
*.log
.vercel

# Playwright MCP browser artifacts (local UI probe outputs)
.playwright-mcp/
*.png

# ZCode session-local plans
.zcode/

# Claude Code local session/worktree state
.claude/

# console/ (app.codingagent.in) — Grok app-builder dev/build artifacts.
# node_modules/ and .vercel/ above already cover console/node_modules/ and
# console/.vercel/ (Nitro's vercel preset builds to console/.vercel/output/,
# the standard Vercel Build Output API location).
console/.tanstack/

# console/ ships real screenshots, favicon and PWA-install PNGs (product
# content, not build artifacts) — carve all of console/ out of the blanket
# *.png rule above. Safe as a blanket allow: console/'s only generated
# output lives under console/.vercel/ and console/node_modules/, both
# already ignored above, so no build-artifact PNG can leak back in here.
!console/**/*.png
